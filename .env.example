# Public ingress port for Docker Compose / Blitz
PORT=8080

# Isolated Cloud Lite channel (generate strong independent values; never commit real values)
SKINPARA_DIRECT_INTERNAL_TOKEN=replace_with_strong_internal_token
SKINPARA_DIRECT_CUSTOMER_KEY_SECRET=replace_with_strong_customer_key_hmac_secret

# Kapso sandbox only
KAPSO_API_KEY=replace_with_kapso_project_api_key
KAPSO_WEBHOOK_SECRET=replace_with_kapso_webhook_signing_secret
KAPSO_SANDBOX_PHONE_NUMBER_ID=replace_with_sandbox_phone_number_id
KAPSO_SANDBOX_ALLOWED_TO=replace_with_approved_sandbox_number

# Professional Advisor
OPENROUTER_API_KEY=replace_with_openrouter_api_key

# Durable catalog and customer memory
SUPABASE_URL=https://project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace_with_supabase_service_role_key
SKINPARA_SUPABASE_ENABLED=true

# Optional Shopify reads. Order mode remains hard-locked to test in compose.
SHOPIFY_SHOP=store-name.myshopify.com
SHOPIFY_CLIENT_ID=replace_if_shopify_reads_are_enabled_later
SHOPIFY_CLIENT_SECRET=replace_if_shopify_reads_are_enabled_later
